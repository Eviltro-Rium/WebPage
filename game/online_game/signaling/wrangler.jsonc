{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furry-trial-online-signal",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
